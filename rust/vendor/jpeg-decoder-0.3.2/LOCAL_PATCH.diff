+#[test]
+fn strict_rejects_bad_restart_number_and_padding() {
+    let restart = RESTART.windows(2).position(|b| b == [0xff, 0xd0]).unwrap();
+    let mut bytes = RESTART.to_vec();
+    bytes[restart + 1] = 0xd1;
+    assert!(!decode(&bytes, true));
+    let mut bytes = RESTART.to_vec();
+    bytes[restart - 1] &= 0xfe;
+    assert!(decode(&bytes, false));
+    assert!(!decode(&bytes, true));
+    let mut bytes = RESTART.to_vec();
+    bytes.drain(restart..restart + 2);
+    assert!(!decode(&bytes, true));
+}
+
+#[test]
+fn strict_rejects_refinement_order_and_all_one_codes() {
+    let last_scan = PROGRESSIVE.windows(2).rposition(|b| b == [0xff, 0xda]).unwrap();
+    let mut bytes = PROGRESSIVE.to_vec();
+    let length = u16::from_be_bytes([bytes[last_scan + 2], bytes[last_scan + 3]]) as usize;
+    // The final scan normally refines from bit 1 to 0. 2-to-1 has valid SOS
+    // syntax but is out of order relative to the preceding coefficient state.
+    assert_eq!(bytes[last_scan + 1 + length], 0x10);
+    bytes[last_scan + 1 + length] = 0x21;
+    assert!(!decode(&bytes, true));
+
+    let mut bytes = tiny();
+    let dht = bytes.windows(2).position(|b| b == [0xff, 0xc4]).unwrap();
+    bytes[dht + 3] += 1; // One more symbol in this DHT.
+    bytes[dht + 5] = 2; // Codes 0 and 1: the latter collides with padding.
+    bytes.insert(dht + 22, 0);
+    assert!(decode(&bytes, false));
+    assert!(!decode(&bytes, true));
+}
