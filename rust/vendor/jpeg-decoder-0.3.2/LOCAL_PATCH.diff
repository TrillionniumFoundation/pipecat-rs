+//! Local strict-profile regressions. Fixtures are generated below from structure
+//! or embedded Pillow 12.3 RGB JPEGs; no external files or runtime tools required.
+use crate::Decoder;
+use std::io::Cursor;
+
+fn decode(bytes: &[u8], strict: bool) -> bool {
+    let mut decoder = Decoder::new(bytes);
+    decoder.set_strict_mode(strict);
+    decoder.decode().is_ok()
+}
+
+// One grayscale 8x8 block, constant 128, with single-bit DC-zero and AC-EOB
+// Huffman codes. Both entropy symbols are zero, followed by six one padding bits.
+fn tiny() -> Vec<u8> {
+    let mut bytes = vec![0xff, 0xd8, 0xff, 0xdb, 0, 67, 0];
+    bytes.extend_from_slice(&[1; 64]);
+    bytes.extend_from_slice(&[0xff, 0xc0, 0, 11, 8, 0, 8, 0, 8, 1, 1, 0x11, 0]);
+    for class in [0, 0x10] {
+        bytes.extend_from_slice(&[0xff, 0xc4, 0, 20, class, 1]);
+        bytes.extend_from_slice(&[0; 15]);
+        bytes.push(0);
+    }
+    bytes.extend_from_slice(&[0xff, 0xda, 0, 8, 1, 1, 0, 0, 63, 0, 0x3f, 0xff, 0xd9]);
+    bytes
+}
+
+#[test]
+fn strict_accepts_baseline_and_progressive() {
+    for bytes in [&tiny()[..], BASELINE, PROGRESSIVE, RESTART] {
+        let mut cursor = Cursor::new(bytes);
+        let mut decoder = Decoder::new(&mut cursor);
+        decoder.set_strict_mode(true);
+        decoder.read_info().unwrap();
+        let pixels = decoder.decode().unwrap();
+        assert!(!pixels.is_empty());
+        drop(decoder);
+        assert_eq!(cursor.position(), bytes.len() as u64);
+    }
+}
+
+#[test]
+fn strict_rejects_synthetic_entropy_and_extra_entropy() {
+    let original = tiny();
+    let entropy = original.len() - 3;
+    let mut truncated = original.clone();
+    truncated.remove(entropy);
+    assert!(decode(&truncated, false)); // Upstream fills missing bits with zero.
+    assert!(!decode(&truncated, true));
+    for extra in [vec![0], vec![0xff, 0], vec![0; 100]] {
+        let mut bytes = original.clone();
+        bytes.splice(entropy + 1..entropy + 1, extra);
+        assert!(decode(&bytes, false));
+        assert!(!decode(&bytes, true));
+    }
+}
+
+#[test]
+fn strict_rejects_bad_padding_missing_eoi_and_intermarker_garbage() {
+    let mut bytes = tiny();
+    let entropy = bytes.len() - 3;
+    bytes[entropy] = 0; // Same two Huffman symbols, invalid alignment padding.
+    assert!(decode(&bytes, false));
+    assert!(!decode(&bytes, true));
+    let original = tiny();
+    assert!(!decode(&original[..original.len() - 2], true));
+    let mut bytes = original.clone();
+    bytes.insert(2, 42);
+    assert!(decode(&bytes, false));
+    assert!(!decode(&bytes, true));
+    let mut bytes = original;
+    let eoi = bytes.len() - 2;
+    bytes.splice(eoi..eoi, [0xff, 0xd0]);
+    assert!(!decode(&bytes, true));
+}
+
+#[test]
+fn strict_requires_complete_progressive_scans() {
+    let scans: Vec<_> = PROGRESSIVE.windows(2).enumerate()
+        .filter_map(|(i, b)| (b == [0xff, 0xda]).then_some(i)).collect();
+    assert!(scans.len() > 1);
+    // End just before the last refinement, keeping earlier marker segments.
+    let mut bytes = PROGRESSIVE[..*scans.last().unwrap()].to_vec();
+    bytes.extend_from_slice(&[0xff, 0xd9]);
+    assert!(decode(&bytes, false));
+    assert!(!decode(&bytes, true));
+    // Repeat the complete first scan: duplicate initial coefficient delivery.
+    let mut bytes = PROGRESSIVE.to_vec();
+    bytes.splice(scans[1]..scans[1], PROGRESSIVE[scans[0]..scans[1]].iter().copied());
+    assert!(!decode(&bytes, true));
+}
+
+#[test]
+fn trailing_bytes_are_detected_by_the_caller() {
+    let original = tiny();
+    let mut bytes = original.clone();
+    bytes.extend_from_slice(b"trailing");
+    let mut cursor = Cursor::new(&bytes);
+    let mut decoder = Decoder::new(&mut cursor);
+    decoder.set_strict_mode(true);
+    decoder.decode().unwrap();
+    drop(decoder);
+    assert_eq!(cursor.position(), original.len() as u64);
+    assert_ne!(cursor.position(), bytes.len() as u64);
+}
