# Export these in the server's environment. No credentials are bundled.
# The server deliberately does not execute or automatically load .env files.
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=

# Optional provider configuration. These match the native runner's defaults.
OPENAI_MODEL=gpt-4.1-mini
CARTESIA_VOICE_ID=86e30c1d-714b-4074-a1f2-1cb6b552fb49
PIPECAT_INPUT_SAMPLE_RATE=16000
PIPECAT_OUTPUT_SAMPLE_RATE=24000
# PIPECAT_SYSTEM_PROMPT=Your spoken-response instruction
