+#[cfg(test)]
+mod pipecat_ownership_tests {
+    use super::*;
+    use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+    struct DropCounter(Arc<AtomicUsize>);
+    impl Drop for DropCounter {
+        fn drop(&mut self) {
+            self.0.fetch_add(1, Ordering::SeqCst);
+        }
+    }
+    fn call(params: &FullParams<'_, '_>) -> bool {
+        // This invokes exactly the ABI pointer/user-data pair used by whisper.cpp.
+        unsafe { params.fp.abort_callback.unwrap()(params.fp.abort_callback_user_data) }
+    }
+    #[test]
+    fn captured_callback_has_correct_layout_and_drops_after_last_clone() {
+        let drops = Arc::new(AtomicUsize::new(0));
+        let cancelled = Arc::new(AtomicBool::new(false));
+        let capture = DropCounter(drops.clone());
+        let flag = cancelled.clone();
+        let mut params = FullParams::new(SamplingStrategy::Greedy { best_of: 1 });
+        params.set_abort_callback_safe(move || {
+            let _keep_alive = &capture;
+            flag.load(Ordering::SeqCst)
+        });
+        assert!(!call(&params));
+        let clone = params.clone();
+        params.set_abort_callback_safe::<_, fn() -> bool>(None::<fn() -> bool>);
+        assert_eq!(drops.load(Ordering::SeqCst), 0);
+        cancelled.store(true, Ordering::SeqCst);
+        assert!(call(&clone));
+        drop(params);
+        assert_eq!(drops.load(Ordering::SeqCst), 0);
+        drop(clone);
+        assert_eq!(drops.load(Ordering::SeqCst), 1);
+    }
+    #[test]
+    fn repeated_callback_replacement_releases_previous_capture() {
+        let drops = Arc::new(AtomicUsize::new(0));
+        let mut params = FullParams::new(SamplingStrategy::Greedy { best_of: 1 });
+        for expected in 0..100 {
+            let capture = DropCounter(drops.clone());
+            params.set_abort_callback_safe(move || {
+                let _keep_alive = &capture;
+                false
+            });
+            assert!(!call(&params));
+            assert_eq!(drops.load(Ordering::SeqCst), expected);
+        }
+        drop(params);
+        assert_eq!(drops.load(Ordering::SeqCst), 100);
+    }
+    #[test]
+    fn callback_panics_abort_without_crossing_native_abi() {
+        let mut params = FullParams::new(SamplingStrategy::Greedy { best_of: 1 });
+        params.set_abort_callback_safe(|| panic!("test callback failure"));
+        assert!(call(&params));
+        assert!(call(&params)); // poisoned callback also aborts
+    }
+    #[test]
+    fn replacing_callback_is_unwind_safe_when_a_capture_destructor_panics() {
+        struct PanicOnDrop;
+        impl Drop for PanicOnDrop {
+            fn drop(&mut self) {
+                panic!("captured destructor failed");
+            }
+        }
+        for install_replacement in [false, true] {
+            let capture = PanicOnDrop;
+            let mut params = FullParams::new(SamplingStrategy::Greedy { best_of: 1 });
+            params.set_abort_callback_safe(move || {
+                let _keep_alive = &capture;
+                false
+            });
+            let outcome = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                if install_replacement {
+                    params.set_abort_callback_safe(|| false);
+                } else {
+                    params.set_abort_callback_safe::<_, fn() -> bool>(None::<fn() -> bool>);
+                }
+            }));
+            assert!(outcome.is_err());
+            if install_replacement {
+                assert!(params.abort_callback_safe.is_some());
+                assert!(!call(&params));
+            } else {
+                assert!(params.abort_callback_safe.is_none());
+                assert!(params.fp.abort_callback.is_none());
+                assert!(params.fp.abort_callback_user_data.is_null());
+            }
+        }
+    }
+    #[test]
+    fn owned_cstrings_survive_clone_and_release_on_replace_and_drop() {
+        let mut params = FullParams::new(SamplingStrategy::Greedy { best_of: 1 });
+        params.set_language(Some("en"));
+        params.set_initial_prompt("first");
+        let language = Arc::downgrade(params.owned_language.as_ref().unwrap());
+        let prompt = Arc::downgrade(params.owned_initial_prompt.as_ref().unwrap());
+        let clone = params.clone();
+        params.set_language(Some("es"));
+        params.set_initial_prompt("second");
+        assert_eq!(
+            unsafe { std::ffi::CStr::from_ptr(clone.fp.language) }
+                .to_str()
+                .unwrap(),
+            "en"
+        );
+        assert_eq!(
+            unsafe { std::ffi::CStr::from_ptr(clone.fp.initial_prompt) }
+                .to_str()
+                .unwrap(),
+            "first"
+        );
+        assert!(language.upgrade().is_some());
+        assert!(prompt.upgrade().is_some());
+        drop(clone);
+        assert!(language.upgrade().is_none());
+        assert!(prompt.upgrade().is_none());
+        let language = Arc::downgrade(params.owned_language.as_ref().unwrap());
+        let prompt = Arc::downgrade(params.owned_initial_prompt.as_ref().unwrap());
+        params.set_language(None);
+        assert!(language.upgrade().is_none());
+        drop(params);
+        assert!(prompt.upgrade().is_none());
+    }
+}
